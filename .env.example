# ── LLM API Key ─────────────────────────────────────────────
# Using OpenAI by default. For Gemini or Anthropic, swap the
# langchain provider in agent.py and update this key.
OPENAI_API_KEY=sk-your-key-here

# Model to use (default: gpt-4o-mini for cost efficiency during dev)
LLM_MODEL=gpt-4o-mini

# ── LTspice ─────────────────────────────────────────────────
# Override if LTspice is installed somewhere other than default
# LTSPICE_BINARY=/Applications/LTspice.app/Contents/MacOS/LTspice

# Max seconds to wait for simulation
# SIMULATION_TIMEOUT=120
